{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string" },
    "workflowName": { "type": "string" },
    "connectorName": { "type": "string", "defaultValue": "office365" },
    "connectionName": { "type": "string", "defaultValue": "" },
    "tags": { "type": "object", "defaultValue": {} }
  },
  "variables": {
    "connName": "[if(empty(parameters('connectionName')), parameters('connectorName'), parameters('connectionName'))]",
    "apiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), parameters('connectorName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[variables('connName')]",
        "api": { "id": "[variables('apiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": { "schema": { "type": "object" } }
            }
          },
          "actions": {
            "Enviar_email": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "method": "post",
                "path": "/v2/Mail",
                "host": {
                  "connection": { "name": "@parameters('$connections')['email']['connectionId']" }
                },
                "body": {
                  "To": "@{triggerBody()?['email']}",
                  "Subject": "@{triggerBody()?['assunto']}",
                  "Body": "@{triggerBody()?['corpoHtml']}",
                  "Attachments": [
                    {
                      "Name": "@{triggerBody()?['anexoNome']}",
                      "ContentBytes": "@{triggerBody()?['anexoBase64']}"
                    }
                  ]
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "email": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connName'))]",
                "connectionName": "[variables('connName')]",
                "id": "[variables('apiId')]"
              }
            }
          }
        }
      }
    }
  ]
}
